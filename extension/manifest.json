{
  "manifest_version": 3,
  "name": "SIH 26171 - Privacy Browser Agent",
  "version": "0.1.0",
  "description": "On-device visual perception + local privacy protection for a lightweight browser agent (SIH26171 prototype)",
  "permissions": ["activeTab", "scripting", "tabs", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "SIH 26171 Privacy Browser Agent"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
